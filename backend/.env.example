# Copy to backend/.env. Never commit real keys.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_CORE=gpt-4.1-mini
# Retained adapter setting; research roles all use CORE.
OPENAI_MODEL_FAST=gpt-4.1-mini
QWEN_API_KEY=
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_CORE=qwen-plus
QWEN_MODEL_FAST=qwen-plus

# Independent task caps: include retries and two rework rounds.
RESEARCH_TOKEN_LIMIT=100000
RESEARCH_TIME_LIMIT_SECONDS=1200
SCOPE_TOKEN_LIMIT=12000
SCOPE_TIME_LIMIT_SECONDS=120

# Provider quotas per process; zero disables a dimension.
LLM_RPM_CORE=0
LLM_RPD_CORE=0
LLM_TPM_CORE=0
LLM_RPM_FAST=0
LLM_RPD_FAST=0
LLM_TPM_FAST=0
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT=180
LLM_MAX_RETRIES=3

SEARCH_PROVIDERS=exa,tavily,ddg
EXA_API_KEY=
TAVILY_API_KEY=
SEARCH_TIMEOUT=30
FRONTEND_ORIGIN=http://localhost:5173
# VANTAGE_DB_PATH=
