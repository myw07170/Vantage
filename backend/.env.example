# Copy to backend/.env and fill in. Never commit the real file.

# ===== LLM: Google Gemini =====================================================
# Required. Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# The free tier has no Pro model — Flash and Flash-Lite only.
#   core = report sections, cross-analysis, audit review
#   fast = intake, clarification, expert dispatch, sentiment classification
GEMINI_MODEL_CORE=gemini-3.5-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# Free-tier quotas. Defaults are conservative — check the real numbers for your
# project at https://aistudio.google.com/rate-limit and raise these to match.
# Getting them WRONG-HIGH means constant 429s; wrong-low just runs slower.
GEMINI_RPM_CORE=10
GEMINI_RPD_CORE=1500
GEMINI_TPM_CORE=250000
GEMINI_RPM_FAST=15
GEMINI_RPD_FAST=1000
GEMINI_TPM_FAST=250000

# Ceiling on simultaneous in-flight LLM calls.
GEMINI_MAX_CONCURRENCY=4
# Thinking budget in tokens (0 = minimal). This pipeline favours fast, stable
# output over deliberation.
GEMINI_THINKING_BUDGET=0

LLM_TIMEOUT=180
LLM_MAX_RETRIES=3

# ===== Search =================================================================
# Ordered failover chain. A provider that 401s or runs out of quota is skipped
# for 5 minutes and the next one takes over.
SEARCH_PROVIDERS=exa,tavily,ddg

# Exa — https://exa.ai  ($20 signup credit + $10/month, ~1,400 searches/mo)
EXA_API_KEY=
# Tavily — https://tavily.com  (1,000 credits/month free)
TAVILY_API_KEY=
# 'ddg' needs no key. It is keyless and unlimited but scraped, rate-limited and
# snippet-only — fine for local development, not for a demo.

SEARCH_TIMEOUT=30

# ===== Social listening =======================================================
# Reddit: register a "script" app at https://www.reddit.com/prefs/apps
# Without these, Reddit falls back to site-restricted web search.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=vantage/0.1 (competitive intelligence research)
# Hacker News needs no credentials (public Algolia API).

# ===== Service ================================================================
# CORS allow-list for the browser app. Comma-separate for multiple origins.
FRONTEND_ORIGIN=http://localhost:5173
