# Copy to backend/.env and fill in. Never commit the real file.

# ===== LLM: mock | qwen | openai ===============================================
# Change this and restart the backend. No automatic provider failover.
# Mock needs no model key, but search/page/social collection still uses network.
# Its reports are marked [MOCK] and contain source notes, not model conclusions.
# Old GEMINI_* settings are ignored; Gemini is no longer supported.
LLM_PROVIDER=mock

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_CORE=gpt-4.1-mini
OPENAI_MODEL_FAST=gpt-4.1-mini

# QWEN_API_KEY takes precedence; DASHSCOPE_API_KEY is a fallback alias.
QWEN_API_KEY=
DASHSCOPE_API_KEY=
# Default Beijing compatibility endpoint. For another region or a workspace
# endpoint, copy its full compatible-mode/v1 base URL from the Model Studio
# console. The API key must belong to that same region.
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL_CORE=qwen-plus
QWEN_MODEL_FAST=qwen-plus

# core/aux = sections, cross-analysis, reviews; fast = scope, plan, sentiment.
# Same model names share the core quota bucket.
# Local per-process caps (not account quota); 0 disables each cap. Set these to
# fit your provider limits. Daily caps reset at midnight fixed UTC-08:00.
LLM_RPM_CORE=0
LLM_RPD_CORE=0
LLM_TPM_CORE=0
LLM_RPM_FAST=0
LLM_RPD_FAST=0
LLM_TPM_FAST=0
LLM_MAX_CONCURRENCY=4

LLM_TIMEOUT=180
LLM_MAX_RETRIES=3

# ===== Search =================================================================
# Ordered failover chain. A provider that 401s or runs out of quota is skipped
# for 5 minutes and the next one takes over.
SEARCH_PROVIDERS=exa,tavily,ddg

# Exa — https://exa.ai  ($20 signup credit + $10/month, ~1,400 searches/mo)
EXA_API_KEY=
# Tavily — https://tavily.com  (1,000 credits/month free)
TAVILY_API_KEY=
# 'ddg' needs no key. It is keyless and unlimited but scraped, rate-limited and
# snippet-only — fine for local development, not for a demo.

SEARCH_TIMEOUT=30

# ===== Social listening =======================================================
# Reddit: register a "script" app at https://www.reddit.com/prefs/apps
# Without these, Reddit falls back to site-restricted web search.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=vantage/0.1 (competitive intelligence research)
# Hacker News needs no credentials (public Algolia API).

# ===== Service ================================================================
# CORS allow-list for the browser app. Comma-separate for multiple origins.
FRONTEND_ORIGIN=http://localhost:5173
